APP_NAME=Smart Trading Indicator
APP_VERSION=1.0.0
CONFIG_VERSION=core_v1
DISABLE_AUTO_START=false
LOG_LEVEL=INFO

SUPABASE_URL=
SUPABASE_KEY=
REDIS_URL=
# Comma-separated allowed browser origins; use * only for local/demo deployments.
CORS_ORIGINS=*

SELECTED_SYMBOLS=BTCUSDT,ETHUSDT,BNBUSDT,SOLUSDT,XRPUSDT,ADAUSDT,DOGEUSDT,AVAXUSDT,LINKUSDT,DOTUSDT,TRXUSDT,LTCUSDT,BCHUSDT,NEARUSDT,UNIUSDT,ATOMUSDT,ETCUSDT,FILUSDT,APTUSDT,ARBUSDT,SUIUSDT,SEIUSDT,OPUSDT,INJUSDT,AAVEUSDT,MKRUSDT,RUNEUSDT,GRTUSDT,APEUSDT,LDOUSDT,IMXUSDT,POLUSDT,TIAUSDT,JUPUSDT,WIFUSDT,PEPEUSDT,SHIBUSDT,FLOKIUSDT,TONUSDT,FETUSDT
ENTRY_TIMEFRAME=15m
ANALYSIS_TIMEFRAMES=5m,15m,1h
STREAM_TIMEFRAMES=5m,15m,1h
STRUCTURE_TIMEFRAME=1h
HTF_TIMEFRAME=4h
HISTORY_LIMIT=500
STALE_DATA_SECONDS=180

MIN_SIGNAL_SCORE=80
MIN_DIRECTION_GAP=15
REQUIRE_CLOSED_CANDLE=true
MAX_PENDING_CANDLES=10
RR_TP1=1.0
RR_TP2=2.0
ATR_BUFFER_MULTIPLIER=0.1
SWING_LEFT=3
SWING_RIGHT=3
ATR_PERIOD=14
MIN_STRUCTURE_BREAK_ATR=0.1

BINANCE_REST_URL=https://data-api.binance.vision/api/v3
BINANCE_WS_URL=wss://data-stream.binance.vision/stream
