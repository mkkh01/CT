# Telegram — server-side only
TELEGRAM_CHAT_ID=
TELEGRAM_BOT_TOKEN=
# Required for the protected /dashboard API; keep private and never commit.
DASHBOARD_TOKEN=

# Supabase — use a server-side key; never expose it in a browser
# REST URL only, for example: https://licqbfixgyzrahuscwnh.supabase.co
# Do not paste the postgresql://... pooler connection string here.
SUPABASE_URL=
SUPABASE_KEY=

# Redis-compatible URL
REDIS_URL=

# Public Binance market-data-only REST endpoint; no API key is used.
BINANCE_REST_URL=https://data-api.binance.vision/api/v3
# Public Binance market-data WebSocket endpoint; no API key is used.
BINANCE_STREAM_URL=wss://data-stream.binance.vision:443/stream

# User can override symbols and capital from Telegram; these are only bootstrap defaults
# Leave empty: add symbols and capital from Telegram using Manage Coins.
SELECTED_SYMBOLS=
INITIAL_CAPITAL_USDT=0

# System policy
MAX_CONCURRENT_POSITIONS=5
DAILY_LOSS_LIMIT_PCT=0.09
RISK_PER_TRADE_PCT=0.005
STOP_LOSS_PCT=0.015
TAKE_PROFIT_R_MULTIPLE=2.0
EXECUTION_TIMEFRAME=1h
HIGHER_TIMEFRAME=4h
SIGNAL_COOLDOWN_SECONDS=3600
# Sideways-market filter: ADX strength and ATR/price volatility ratio.
ADX_PERIOD=14
ADX_MIN=25.0
ATR_PERIOD=14
ATR_MIN_PCT=0.003
ATR_MAX_PCT=0.08
HEARTBEAT_INTERVAL_SECONDS=15
STALE_DATA_SECONDS=180
LOG_LEVEL=INFO
